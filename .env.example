# Archypix self-hosted stack — copy this file to `.env` and fill it in.
#   cp .env.example .env

# ── Image tag ──────────────────────────────────────────────────────────────────
# Docker tag published by CI to ghcr.io/clementgre/archypix-{back,worker,front}. "main" tracks
# the latest build; pin a commit SHA or release tag for reproducible deployments.
TAG=main

# ── Domains ────────────────────────────────────────────────────────────────────
# The federated identity domain: user handles look like @username:GLOBAL_DOMAIN, and it's what
# other instances resolve to find yours. Needs a DNS record pointing at this host — only the
# /archypix-resolver path is forwarded from it (to the backend), so the rest of the domain is
# free for a landing page or anything else.
GLOBAL_DOMAIN=example.com

# Where the frontend (web app) is served from. Needs its own DNS record.
FRONT_DOMAIN=archypix.example.com

# Where the backend API/WebDAV is served from — the domain clients and other instances actually
# talk to for everything except resolution. Needs its own DNS record. Can equal GLOBAL_DOMAIN,
# but a separate subdomain keeps your public identity domain free of infrastructure-looking URLs.
BACK_DOMAIN=archypix-back.example.com

# Origin(s) allowed to call the backend API from a browser, comma-separated. Must include
# FRONT_DOMAIN; add https://archypix.com too if you'd rather use the hosted client than deploy
# your own frontend (in which case you can drop the `front` service in docker-compose.yml).
CORS_ORIGINS=https://archypix.example.com

# ── Secrets ────────────────────────────────────────────────────────────────────
# Generate with e.g. `openssl rand -hex 32`. Keep JWT_SECRET stable — rotating it logs out
# every user. WORKER_JWT_SECRET is shared verbatim between the backend and worker containers.
JWT_SECRET=
WORKER_JWT_SECRET=

# ── Postgres ───────────────────────────────────────────────────────────────────
DB_USER=archypix
DB_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Object storage: MinIO or external S3 ────────────────────────────────────────
# MinIO is bundled in docker-compose.yml as the default, zero-config option — S3_DOMAIN needs
# its own DNS record (presigned URLs are handed straight to browsers) and S3_ACCESS_KEY /
# S3_SECRET_KEY double as its root credentials.
#
# To use an external S3-compatible provider instead (AWS S3, Backblaze B2, Cloudflare R2,
# another MinIO...), see the comment on the `minio` service in docker-compose.yml: delete that
# service, then set S3_ACCESS_KEY/S3_SECRET_KEY to your provider's credentials and uncomment
# S3_ENDPOINT/S3_PUBLIC_ENDPOINT/S3_REGION below to point at it. Most providers require globally
# unique bucket names — if yours does, also add S3_BUCKET_STAGING/PICTURES/VERSIONS/SMALL/
# MEDIUM/LARGE to the backend's `environment:` in docker-compose.yml.
S3_DOMAIN=s3.example.com
S3_ACCESS_KEY=archypix
S3_SECRET_KEY=
# S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# S3_PUBLIC_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# S3_REGION=us-west-002

# ── Logging ────────────────────────────────────────────────────────────────────
RUST_LOG=info
