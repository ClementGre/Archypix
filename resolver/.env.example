# ─────────────────────────────────────────────────────────────────────────────
# MANDATORY  (core config — env-only, never runtime-editable)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────
DB_HOST=postgres-host
DB_USER=archypix
DB_PASSWORD=change-me-in-production
DB_NAME=archypix_resolver

# ── Identity ──────────────────────────────────
# The global identity domain managed by this resolver: the part after ':' in
# user handles (@user:global_domain). Must match the GLOBAL_DOMAIN set on all
# backends that register with this resolver.
GLOBAL_DOMAIN=archypix.com

# Shared JWT secret authenticating backend→resolver *pushes* (self-register /
# mapping update / heartbeat) and signing operator dashboard sessions. Every
# registered backend must set the same value as its RESOLVER_JWT_SECRET.
RESOLVER_JWT_SECRET=change-me-in-production


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — core  (env-only, shown with their default values)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────
LISTEN_ADDR=0.0.0.0:80

# ── Identity ──────────────────────────────────
# Serve the public api_url (advertised by /archypix-resolver/info) over HTTPS.
# Set false in local/Docker (HTTP) environments.
USE_HTTPS=true
# Externally-reachable base URL of this resolver INCLUDING the /archypix-resolver
# prefix — what the frontend and browsers use for registration and the fleet
# dashboard. Defaults to {scheme}://{GLOBAL_DOMAIN}/archypix-resolver. Override
# only when the resolver is served on a different host/path than the identity domain.
#PUBLIC_URL=https://archypix.com/archypix-resolver

# ── Database ──────────────────────────────────
DB_PORT=5432

# ── Authentication ────────────────────────────
# Operator token for the fleet admin dashboard (plaintext or an argon2 hash).
# If unset, one is generated and printed to the console ONCE at first startup.
#RESOLVER_ADMIN_TOKEN=

# ── Cache ─────────────────────────────────────
# How long (seconds) a username→backend mapping is cached before re-reading it.
CACHE_TTL_SECS=3600
# Maximum number of entries in the in-process cache.
CACHE_MAX_CAPACITY=100000


# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME (Manage them from /admin/resolver → Routines)
#
# Runtime env have working defaults and are best left unset here: setting one
# via an env var locks the field (the dashboard shows it read-only, "defined by
# environment"). Use envs only to pin a value as infrastructure-as-code.
# ─────────────────────────────────────────────────────────────────────────────
