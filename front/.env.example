# ─────────────────────────────────────────────────────────────────────────────
# MANDATORY
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity domain ───────────────────────────────────────────────────────────
# The global/identity domain the frontend is associated with.
# This is the part after ':' in user handles (@user:global_domain) and is used
# for WebFinger lookups and as the target for cross-domain federation requests.
VITE_GLOBAL_DOMAIN=archypix.test

# ── TLS / scheme ──────────────────────────────────────────────────────────────
# Whether to use HTTPS when contacting the global domain (WebFinger + API calls).
# Set to true in production; false for local HTTP-only dev environments.
VITE_USE_HTTPS=false

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL  (shown with their default values)
# ─────────────────────────────────────────────────────────────────────────────

# ── Registration mode ─────────────────────────────────────────────────────────
# Controls how the registration POST is resolved:
#   auto       — auto-detect: if USE_RESOLVER=true on the backend, resolves via
#                WebFinger; otherwise falls back to standalone mode.
#   resolver   — always POST to {scheme}://{VITE_GLOBAL_DOMAIN}/api/register
#                (the resolver handles backend assignment).
#   standalone — resolve the backend via WebFinger first, then POST to
#                {backend}/api/public/users (single-backend, no resolver).
VITE_REGISTRATION_MODE=auto

# ── Registration URL override ─────────────────────────────────────────────────
# Optional explicit URL for the registration POST endpoint. When set, overrides
# VITE_REGISTRATION_MODE entirely — the frontend posts directly to this URL.
# Leave blank to let VITE_REGISTRATION_MODE control the target.
VITE_REGISTRATION_URL=
