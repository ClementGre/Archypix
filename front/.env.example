# ─────────────────────────────────────────────────────────────────────────────
# MANDATORY
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity domain ───────────────────────────────────────────────────────────
# The global/identity domain the frontend is associated with.
# This is the part after ':' in user handles (@user:global_domain) and is used
# for WebFinger lookups and as the target for cross-domain federation requests.
VITE_GLOBAL_DOMAIN=archypix.test

# ── TLS / scheme ──────────────────────────────────────────────────────────────
# Whether to use HTTPS when contacting the global domain (WebFinger + API calls).
# Set to true in production; false for local HTTP-only dev environments.
VITE_USE_HTTPS=false
